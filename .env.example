# Sales Data Analysis System - Configuration

# Flask Secret Key
SECRET_KEY=sales-analysis-secret-key-2026

# Database Type:
# 'auto'   -> Tries MySQL; if unreachable, falls back to SQLite
# 'sqlite' -> Uses SQLite (bundled sales_data.db / /tmp in serverless)
# 'mysql'  -> Forces MySQL
DB_TYPE=auto

# Option A: Full Connection String (Standard on Vercel, Railway, PlanetScale, Aiven)
# DATABASE_URL=mysql://user:password@host:3306/sales_db
# DB_SSL=true

# Option B: Individual MySQL Connection Parameters
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sales_db
DB_SSL=false

# SQLite Path Override (optional; on Vercel defaults automatically to /tmp/sales_data.db)
# SQLITE_DB_PATH=/tmp/sales_data.db
